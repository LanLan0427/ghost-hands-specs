    Node5:
      DependencyIndex: 5
      LevelID: 0
      NodeCount: 0
      NodeType: 1
      Ports:
        Code:
          ClassType1: TEXT
          String: |-
            input_vec4 base;
            input_vec3 rimCol;
            input_float rimPow;
            input_float rimStr;
            input_float bodyOp;
            output_vec4 result;

            void main()
            {
            	vec3 N = normalize(system.getSurfaceNormalWorldSpace());
            	vec3 V = normalize(system.getCameraPosition() - system.getSurfacePositionWorldSpace());
            	float ndv = clamp(abs(dot(N, V)), 0.0, 1.0);
            	float fres = pow(1.0 - ndv, max(rimPow, 0.1));
            	float key = 0.55 + 0.45 * clamp(dot(N, normalize(vec3(0.35, 1.0, 0.6))), 0.0, 1.0);
            	vec3 body = base.rgb * key;
            	float r = clamp(fres * rimStr, 0.0, 1.0);
            	vec3 col = mix(body, rimCol, r);
            	float a = clamp(bodyOp + r, 0.0, 1.0) * base.a;
            	result = vec4(col, a);
            }
        CustomCodeNodeAsset:
          ClassType1: REFUID
          String: ""
        Description:
          ClassType1: TEXT
          String: "Ghost hand: light body with soft top light + fresnel glowing rim"
        Examples:
          ItemIndex: 0
          ItemList: "Custom : Input/Output/Global Types : Extra Functions : Procedural Execution : Lighting Loop : System Built-In Values/Functions"
        ID:
          Variable: 0
        Locked:
          Variable: false
        Stage:
          ItemIndex: 1
          ItemList: "Vertex : Pixel"
        Title:
          String: Ghost Rim
        UseExternalFile:
          Variable: false
        base:
          Connection0:
            NodeLevelID: 1
            PortID: Output
          Variable: [0.0, 0.0, 0.0, 0.0]
        rimCol:
          Connection0:
            NodeLevelID: 2
            PortID: Output
          Variable: [0.0, 0.0, 0.0]
        rimPow:
          Connection0:
            NodeLevelID: 3
            PortID: Output
          Variable: 0.0
        rimStr:
          Connection0:
            NodeLevelID: 5
            PortID: Output
          Variable: 0.0
        bodyOp:
          Connection0:
            NodeLevelID: 6
            PortID: Output
          Variable: 0.0
        ngs_Height:
          Variable: 400
        ngs_Version:
          String: 0.1.0
        result:
          IOType: 1
          Variable: [0.0, 0.0, 0.0, 0.0]
      PositionX: -59
